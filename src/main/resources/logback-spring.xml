<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- TEXT format (colorized, for dev) -->
    <appender name="CONSOLE_TEXT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr([%thread]){faint} %clr(%-5level){highlight}
                %clr(%logger{36}){cyan}%clr(%replace( [trace=%X{traceId}]){'\\s\\[trace=\\]', ''}){yellow}%clr(%replace(
                [span=%X{spanId}]){'\\s\\[span=\\]', ''}){yellow}%clr(%replace(
                [pid=%X{process_instance_id}]){'\\s\\[pid=\\]', ''}){magenta}%clr(%replace(
                [act=%X{activity_id}]){'\\s\\[act=\\]', ''}){magenta}%clr(%replace(
                [user=%X{user_id}]){'\\s\\[user=\\]', ''}){blue} %clr(-){faint} %msg%n
            </pattern>
        </encoder>
    </appender>

    <!-- JSON format (for production/k8s) -->
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>
                {"timestamp":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}","level":"%level","logger":"%logger{36}","thread":"%thread","message":"%replace(%msg){'"','\\"'}","trace_id":"%X{traceId}","span_id":"%X{spanId}","process_instance_id":"%X{process_instance_id}","activity_id":"%X{activity_id}","user_id":"%X{user_id}","request_id":"%X{request_id}"}%n
            </pattern>
        </encoder>
    </appender>

    <!-- Appender selection via Spring Profile -->
    <springProfile name="json-logging">
        <root level="INFO">
            <appender-ref ref="CONSOLE_JSON"/>
        </root>
    </springProfile>

    <springProfile name="!json-logging">
        <root level="INFO">
            <appender-ref ref="CONSOLE_TEXT"/>
        </root>
    </springProfile>

    <!-- Log levels shared across all profiles -->
    <logger name="ru.briany" level="INFO"/>
    <logger name="org.flowable" level="INFO"/>
    <logger name="org.springframework" level="INFO"/>
    <logger name="org.apache.kafka" level="INFO"/>
    <logger name="org.springframework.kafka" level="INFO"/>
    <logger name="liquibase" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>
</configuration>
