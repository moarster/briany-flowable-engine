<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             targetNamespace="http://briany.ru/modeler">
  <process id="modelerProcessA" name="Modeler Process A v2" isExecutable="true">
    <documentation>First modeler process, revised</documentation>
    <startEvent id="start"/>
    <userTask id="review" name="Review"/>
    <sequenceFlow id="flow1" sourceRef="start" targetRef="review"/>
    <sequenceFlow id="flow2" sourceRef="review" targetRef="end"/>
    <endEvent id="end"/>
  </process>
</definitions>
