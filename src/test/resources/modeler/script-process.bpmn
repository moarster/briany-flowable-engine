<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://briany.ru/modeler">
  <process id="scriptProcess" name="Script Process" isExecutable="true">
    <startEvent id="start"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="scriptTask1"/>
    <scriptTask id="scriptTask1" name="Bad Script" scriptFormat="groovy">
      <script>println 'hello'</script>
    </scriptTask>
    <sequenceFlow id="f2" sourceRef="scriptTask1" targetRef="end"/>
    <endEvent id="end"/>
  </process>
</definitions>
