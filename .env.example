# Copy to .env and adjust. Consumed by docker-compose.yml / docker-compose.jwks.yml.

# ---- Database ---------------------------------------------------------------
POSTGRES_USER=flowable
POSTGRES_PASSWORD=flowable
POSTGRES_DB=flowable
DB_PORT=5432

# ---- Application ------------------------------------------------------------
# Prebuilt image to run instead of a local build (optional).
# BPM_IMAGE=briany-flowable-engine:latest
BPM_PORT=8095
BPM_MGMT_PORT=8096

# Password for the seeded Flowable IDM admin user (login: admin). Required.
IDM_ADMIN_PASSWORD=change-me

# Auth strategy: "flowable" (HTTP Basic against the engine IDM) or "jwks".
BRIANY_SECURITY_AUTH_STRATEGY=flowable

# ---- JWKS strategy (only for docker-compose.jwks.yml) -----------------------
JWKS_ISSUER_URI=http://keycloak:8080/realms/bpm
JWKS_JWK_SET_URI=http://keycloak:8080/realms/bpm/protocol/openid-connect/certs
JWKS_AUDIENCES=
JWKS_USERNAME_CLAIM=preferred_username
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080
